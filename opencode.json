{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "shadcn": {
        "type": "local",
        "command": ["npx", "shadcn@latest", "mcp"]
      },
      "supabase": {
        "type": "remote",
        "url": "https://mcp.supabase.com/mcp"
      },
      "next-devtools": {
        "type": "local",
        "command": ["npx", "-y", "next-devtools-mcp@latest"]
      }
    }
  }
}
